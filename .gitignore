# Nothing derived from the game ROM may ever be committed.
# Only our own source code is distributable.
rom-extract/
rom/
*.3ds
*.cci
*.cxi
code.bin
code_dec.bin
exheader.bin
banner.bin
icon.bin
romfs/

# Translated guest code: a mechanical translation of the game binary, so it is as
# undistributable as the binary itself. Regenerate with tools/recompile.py.
src/generated/

# Ghidra projects and their backups (derived from the ROM, and huge).
# Anchored to the repo root: an unanchored ghidra*/ also matches tools/ghidra_scripts/.
/ghidra*/
*.gpr
*.rep/

build/
# Other build directories (build-win/ for Windows): they hold the translated game as much as build/.
build-*/

# Python byte code
__pycache__/

# SDKs downloaded for building, never committed (the DLSS one is under NVIDIA's licence)
external/

# The card folder a build in the tree keeps the player's card in (src/runtime/albw_card.h).
/card/
